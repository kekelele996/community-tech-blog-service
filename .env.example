# ===== techblog 环境变量示例 =====
# 复制为 .env 后按需修改；docker compose 会自动读取 .env

# Compose 项目名（同时用于容器名前缀）
COMPOSE_PROJECT_NAME=techblog
# 运行环境：dev / prod
APP_ENV=prod

# 端口映射（宿主机端口）
FRONTEND_PORT=8102
BACKEND_PORT=3102
DB_PORT=3502
REDIS_PORT=6502

# MySQL 数据库
DB_NAME=techblog_db
DB_USER=techblog_user
DB_PASSWORD=techblog_pwd
DB_ROOT_PASSWORD=root_techblog_pwd

# JWT 认证（生产环境务必修改为足够长的随机字符串）
JWT_SECRET=change_me_to_a_long_random_string
JWT_TTL_HOURS=72

# Redis 缓存
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# 演示模式：发送验证码接口返回 debug_code，方便本地联调；生产环境设为 false
DEBUG_CODE_MODE=true

# 初始管理员账号（后端启动时自动创建）
ADMIN_EMAIL=admin@techblog.com
ADMIN_PASSWORD=admin123456
