# TechBlog 本地 Compose 启动配置（仅用于开发/评测）
COMPOSE_PROJECT_NAME=techblog
APP_ENV=prod
FRONTEND_PORT=8102
BACKEND_PORT=3102
DB_PORT=3502
REDIS_PORT=6502
DB_NAME=techblog_db
DB_USER=techblog_user
DB_PASSWORD=techblog_pwd
DB_ROOT_PASSWORD=root_techblog_pwd
JWT_SECRET=change_me_to_a_long_random_string
JWT_TTL_HOURS=72
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
DEBUG_CODE_MODE=true
ADMIN_EMAIL=admin@techblog.com
ADMIN_PASSWORD=admin123456
