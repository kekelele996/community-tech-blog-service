# techblog 环境变量（docker compose 自动读取）
COMPOSE_PROJECT_NAME=techblog
APP_ENV=prod

# 端口映射
FRONTEND_PORT=8102
BACKEND_PORT=3102
DB_PORT=3502
REDIS_PORT=6502

# 数据库
DB_NAME=techblog_db
DB_USER=techblog_user
DB_PASSWORD=techblog_pwd
DB_ROOT_PASSWORD=root_techblog_pwd

# 认证
JWT_SECRET=change_me_to_a_long_random_string
JWT_TTL_HOURS=72

# 缓存
REDIS_ADDR=redis:6379
REDIS_PASSWORD=

# 演示模式：发送验证码接口返回 debug_code（生产环境请关闭）
DEBUG_CODE_MODE=true

# 初始管理员
ADMIN_EMAIL=admin@techblog.com
ADMIN_PASSWORD=admin123456
